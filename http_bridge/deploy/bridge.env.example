BRIDGE_ALLOWED_ORIGINS=https://client.meshtastic.org
BRIDGE_HTTP_HOST=0.0.0.0
BRIDGE_HTTP_PORT=4407
BRIDGE_MUX_HOST=127.0.0.1
BRIDGE_MUX_PORT=4405
BRIDGE_HTTPS_PORT=4408
BRIDGE_TLS_CERT=/etc/meshtastic-http-bridge/server.crt
BRIDGE_TLS_KEY=/etc/meshtastic-http-bridge/server.key
BRIDGE_MAX_SESSIONS=8
BRIDGE_MAX_QUEUE_FRAMES=2048
BRIDGE_MAX_QUEUE_BYTES=1048576
BRIDGE_IDLE_SECONDS=120
