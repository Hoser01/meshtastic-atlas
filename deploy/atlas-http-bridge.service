[Unit]
Description=ATLAS Meshtastic HTTP-to-TCP bridge
After=network-online.target meshtastic-tcp-mux.service
Wants=network-online.target meshtastic-tcp-mux.service

[Service]
Type=simple
User=atlas-observer
Group=atlas-observer
EnvironmentFile=-/etc/atlas-observer/observer.env
EnvironmentFile=/etc/atlas-http-bridge/bridge.env
ExecStart=/opt/atlas-observer/current/bin/atlas-http-bridge
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
