# Listen on the LAN for Meshtastic HTTP PhoneAPI clients.
ATLAS_HTTP_LISTEN_HOST=0.0.0.0
ATLAS_HTTP_LISTEN_PORT=4404

# The bridge is another client of the local Meshtastic TCP MUX.
ATLAS_HTTP_MUX_HOST=127.0.0.1
ATLAS_HTTP_MUX_PORT=4405

# Bounded receive queue. Oldest frames are discarded at either limit.
ATLAS_HTTP_QUEUE_FRAMES=4096
ATLAS_HTTP_QUEUE_BYTES=2097152
ATLAS_HTTP_LOG_LEVEL=INFO

# Optional TLS. Set both paths or leave both empty.
ATLAS_HTTP_TLS_CERT=
ATLAS_HTTP_TLS_KEY=
