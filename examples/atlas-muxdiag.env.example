# Example deployment values; do not put secrets in this file.
ATLAS_MUX_HOST=127.0.0.1
ATLAS_MUX_PORT=4405
ATLAS_OBSERVER_ID=CHANGE_ME
ATLAS_LOCAL_NODE=!00000000
ATLAS_CAPTURE_DIR=/var/lib/atlas/captures

# Optional test event bus. MQTT remains disabled unless --enable-mqtt is passed.
ATLAS_MQTT_HOST=test-broker.example
ATLAS_MQTT_PORT=1883
ATLAS_MQTT_PREFIX=atlas/test
